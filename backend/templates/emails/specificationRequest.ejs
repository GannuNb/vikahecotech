<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Complete Specifications</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f7f8;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2933;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color: #f4f7f8; padding: 30px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 600px;
            width: 100%;
            background-color: #ffffff;
            border-radius: 10px;
            overflow: hidden;
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background-color: #0f4c5c;
                padding: 28px 30px;
                text-align: center;
              "
            >
              <div
                style="
                  color: #ffffff;
                  font-size: 24px;
                  font-weight: bold;
                  line-height: 1.3;
                "
              >
                Vikah Ecotech
              </div>

              <div
                style="
                  color: #d9e2e6;
                  font-size: 13px;
                  margin-top: 6px;
                "
              >
                Industrial Recycling Solutions
              </div>
            </td>
          </tr>

          <!-- Green Accent -->
          <tr>
            <td
              style="
                height: 5px;
                background-color: #1f7a5a;
                font-size: 0;
                line-height: 0;
              "
            >
              &nbsp;
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 35px 30px 25px 30px;">

              <div
                style="
                  font-size: 22px;
                  font-weight: bold;
                  color: #0f4c5c;
                  margin-bottom: 15px;
                "
              >
                Complete Specifications
              </div>

              <div
                style="
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                "
              >
                Dear Customer,
              </div>

              <div
                style="
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                  margin-top: 12px;
                "
              >
                Thank you for your interest in
                <strong style="color: #1f2933;">
                  <%= modelName %>
                </strong>.
              </div>

              <div
                style="
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                  margin-top: 12px;
                "
              >
                Please find the complete technical specifications
                attached to this email as a PDF.
              </div>

              <!-- Product Information -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin-top: 25px;
                  border: 1px solid #d9e2e6;
                  border-radius: 8px;
                  overflow: hidden;
                "
              >
                <tr>
                  <td
                    colspan="2"
                    style="
                      background-color: #f5f8f9;
                      padding: 13px 16px;
                      font-size: 14px;
                      font-weight: bold;
                      color: #0f4c5c;
                    "
                  >
                    Product Information
                  </td>
                </tr>

                <tr>
                  <td
                    width="35%"
                    style="
                      padding: 12px 16px;
                      border-top: 1px solid #e5e7eb;
                      font-size: 13px;
                      color: #6b7280;
                    "
                  >
                    Model
                  </td>

                  <td
                    style="
                      padding: 12px 16px;
                      border-top: 1px solid #e5e7eb;
                      font-size: 13px;
                      font-weight: bold;
                      color: #1f2933;
                    "
                  >
                    <%= modelName %>
                  </td>
                </tr>

                <tr>
                  <td
                    style="
                      padding: 12px 16px;
                      border-top: 1px solid #e5e7eb;
                      font-size: 13px;
                      color: #6b7280;
                    "
                  >
                    Application
                  </td>

                  <td
                    style="
                      padding: 12px 16px;
                      border-top: 1px solid #e5e7eb;
                      font-size: 13px;
                      color: #1f2933;
                    "
                  >
                    <%= applicationName %>
                  </td>
                </tr>

                <tr>
                  <td
                    style="
                      padding: 12px 16px;
                      border-top: 1px solid #e5e7eb;
                      font-size: 13px;
                      color: #6b7280;
                    "
                  >
                    Category
                  </td>

                  <td
                    style="
                      padding: 12px 16px;
                      border-top: 1px solid #e5e7eb;
                      font-size: 13px;
                      color: #1f2933;
                    "
                  >
                    <%= categoryName %>
                  </td>
                </tr>
              </table>

              <!-- Attachment Notice -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin-top: 25px;
                  background-color: #f0f7f5;
                  border-left: 4px solid #1f7a5a;
                "
              >
                <tr>
                  <td style="padding: 15px 17px;">
                    <div
                      style="
                        font-size: 14px;
                        font-weight: bold;
                        color: #1f7a5a;
                      "
                    >
                      PDF Attached
                    </div>

                    <div
                      style="
                        font-size: 13px;
                        color: #4b5563;
                        margin-top: 5px;
                        line-height: 1.5;
                      "
                    >
                      Your complete technical specification document
                      is attached to this email.
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Closing -->
              <div
                style="
                  margin-top: 28px;
                  font-size: 14px;
                  line-height: 1.7;
                  color: #4b5563;
                "
              >
                If you have any questions or require further information,
                please feel free to contact our team.
              </div>

              <div
                style="
                  margin-top: 20px;
                  font-size: 14px;
                  line-height: 1.6;
                  color: #1f2933;
                "
              >
                Regards,<br />

                <strong>
                  Vikah Ecotech Pvt Ltd
                </strong>
              </div>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                background-color: #1f2933;
                padding: 22px 30px;
                text-align: center;
              "
            >
              <div
                style="
                  color: #ffffff;
                  font-size: 13px;
                  font-weight: bold;
                "
              >
                Vikah Ecotech Pvt Ltd
              </div>

              <div
                style="
                  color: #b8c2c9;
                  font-size: 11px;
                  margin-top: 6px;
                  line-height: 1.5;
                "
              >
                Industrial Recycling &amp; Waste Management Solutions
              </div>

              <div
                style="
                  color: #8f9aa3;
                  font-size: 10px;
                  margin-top: 10px;
                "
              >
                This is an automated email. Please do not reply directly
                to this message.
              </div>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>